# ============================================
# Portfolio Next.js - Environment Variables
# ============================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
# ============================================

# --------------------------------------------
# DATABASE (Required)
# --------------------------------------------
# PostgreSQL is required for Vercel/serverless deployments.
# Use the same format locally if you want to test against your production-like DB.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# --------------------------------------------
# NEXT.JS
# --------------------------------------------
NODE_ENV="development"

# --------------------------------------------
# EMAIL (Optional - for contact form notifications)
# --------------------------------------------
# Enable email notifications when someone submits the contact form.
# Uses SMTP. For Gmail, use an App Password (not your real password).
#
# EMAIL_HOST="smtp.gmail.com"
# EMAIL_PORT="587"
# EMAIL_USE_TLS="true"
# EMAIL_HOST_USER="you@gmail.com"
# EMAIL_HOST_PASSWORD="your-app-password"
# CONTACT_NOTIFICATION_EMAIL="you@gmail.com"
#
# For Vercel / serverless (no SMTP), use a transactional email API:
# RESEND_API_KEY="re_xxxxxxxxxxxxx"
# CONTACT_NOTIFICATION_EMAIL="you@gmail.com"

# --------------------------------------------
# CLOUDINARY (Optional - for image uploads)
# --------------------------------------------
# If you want to store portfolio images on Cloudinary instead of local disk:
# CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# --------------------------------------------
# DEPLOYMENT
# --------------------------------------------
# Auto-set by Vercel. You usually don't need to change these.
# VERCEL="1"
# VERCEL_URL="your-project.vercel.app"
